# Litestream settings. Copy to /etc/annette-cards/litestream.env on the VPS, mode 0640 root:annette. Never commit.
LITESTREAM_BUCKET=annette-backups
# S3-compatible endpoint, e.g. https://<account>.r2.cloudflarestorage.com or https://s3.eu-central-003.backblazeb2.com
LITESTREAM_ENDPOINT=https://s3.example.com
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
