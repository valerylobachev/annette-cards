# Production settings of the server (docs/architecture.md §10). Copy to /etc/annette-cards/env on the VPS,
# mode 0640 root:annette (`sudo install -m 640 -o root -g annette env.example /etc/annette-cards/env`), and fill in.
# Never commit the real file: it holds secrets.

# Caddy proxies to this address; keep it on localhost.
ANNETTE_BIND=127.0.0.1:8080
ANNETTE_DATABASE_URL=sqlite:///var/lib/annette-cards/annette.db
# The public origin: the Origin check rejects every write without it, and CLI invite links use it.
ANNETTE_PUBLIC_URL=https://cards.example.com
ANNETTE_SESSION_TTL_DAYS=90
ANNETTE_LOG_FORMAT=json
RUST_LOG=info

# --- Optional features: each is disabled until its variables are set (see /api/meta) ---
# Text-to-speech (Azure AI Speech, Phase 3)
# ANNETTE_AZURE_TTS_KEY=
# ANNETTE_AZURE_TTS_REGION=
# Wikimedia Commons recordings (Phase 3)
# ANNETTE_COMMONS_ENABLED=true
# AI enrichment (Anthropic, Phase 3)
# ANTHROPIC_API_KEY=
# ANNETTE_LLM_MODEL=
# ANNETTE_ENRICH_DAILY_LIMIT=200
# Web Push reminders (Phase 4)
# ANNETTE_VAPID_PUBLIC_KEY=
# ANNETTE_VAPID_PRIVATE_KEY=
