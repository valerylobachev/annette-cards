# Copy to server/.env (never commit .env). `just` recipes load it; the defaults below work for local development.
# All variables: docs/architecture.md §10.

# Listen address
ANNETTE_BIND=127.0.0.1:8080
# SQLite database; relative paths are resolved from server/
ANNETTE_DATABASE_URL=sqlite://data/annette.db
# Public origin: invite links printed by the CLI and the Origin check (required in production), e.g. https://cards.example.com
# ANNETTE_PUBLIC_URL=
# Also accept API writes from the Vite dev server (http://localhost:5173, http://127.0.0.1:5173, https://localhost:5173).
# Default: true in debug builds, false in release builds. For `just dev-https` on an iPhone, set ANNETTE_PUBLIC_URL
# to https://<mac-ip>:5173 instead.
# ANNETTE_DEV_ORIGINS=true
# Sliding session lifetime in days
ANNETTE_SESSION_TTL_DAYS=90
# Log format: pretty | json (default: pretty in debug builds, json in release builds)
# ANNETTE_LOG_FORMAT=pretty
# Log filter (tracing EnvFilter syntax)
RUST_LOG=info,tower_http=debug

# --- Optional features: each is disabled until its variables are set (see /api/meta) ---
# Text-to-speech (Azure AI Speech)
# ANNETTE_AZURE_TTS_KEY=
# ANNETTE_AZURE_TTS_REGION=
# Wikimedia Commons recordings
# ANNETTE_COMMONS_ENABLED=true
# AI enrichment (Anthropic)
# ANTHROPIC_API_KEY=
# ANNETTE_LLM_MODEL=
# ANNETTE_ENRICH_DAILY_LIMIT=200
# Web Push reminders
# ANNETTE_VAPID_PUBLIC_KEY=
# ANNETTE_VAPID_PRIVATE_KEY=
