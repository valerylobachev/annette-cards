{
  "openapi": "3.1.0",
  "info": {
    "title": "Annette Cards API",
    "description": "Annette Cards server: API, sync and the embedded PWA",
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/invites": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "All invites with their status.",
        "operationId": "list_invites",
        "responses": {
          "200": {
            "description": "Invites, newest expiry first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InviteSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Creates a single-use invite.",
        "operationId": "create_invite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new invite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteSummary"
                }
              }
            }
          },
          "400": {
            "description": "`validation_failed`: days outside 1–90 or note too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/admin/invites/{code}": {
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Revokes (deletes) an unused invite.",
        "operationId": "revoke_invite",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "description": "Invite code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`invite_used`: used invites stay as a record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with email and password and sets the `ac_session` cookie.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the response sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`: unknown email or wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`: more than 10 attempts a minute from this address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out: revokes the current session and clears the cookie.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "`unauthorized`: no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/logout-others": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revokes all sessions of the user except the current one.",
        "operationId": "logout_others",
        "responses": {
          "204": {
            "description": "Other sessions revoked"
          },
          "401": {
            "description": "`unauthorized`: no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user. Also renews the cookie's lifetime, which keeps the sliding session alive in the browser.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`: no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Changes the password and signs out all other sessions.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed; other sessions revoked"
          },
          "400": {
            "description": "`invalid_credentials` (wrong current password) or `password_too_short`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`: no valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates an account with an invite code and signs it in (sets the `ac_session` cookie like login).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Registered and signed in; the response sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invite_invalid` (unknown or used code), `invite_expired`, `password_too_short` or `validation_failed` (email, or display name empty or over 100 characters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`email_taken`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`: more than 10 attempts a minute from this address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check including a database ping.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Server version and enabled optional features.",
        "operationId": "meta",
        "responses": {
          "200": {
            "description": "Server metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "CreateInviteRequest": {
        "type": "object",
        "properties": {
          "days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Days until the invite expires, 1–90 (default 7)."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who the invite is for, e.g. \"Anna\"; at most 200 characters."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error response body: `{ \"code\": \"not_found\", \"details\": null }`.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable snake_case error code, never user-facing text."
          },
          "details": {
            "description": "Optional machine-readable details (e.g. which field is invalid)."
          }
        }
      },
      "Features": {
        "type": "object",
        "description": "Optional server features; the client hides the UI of disabled ones.",
        "required": [
          "tts",
          "commons",
          "enrich",
          "push"
        ],
        "properties": {
          "commons": {
            "type": "boolean"
          },
          "enrich": {
            "type": "boolean"
          },
          "push": {
            "type": "boolean"
          },
          "tts": {
            "type": "boolean"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "InviteStatus": {
        "type": "string",
        "enum": [
          "active",
          "used",
          "expired"
        ]
      },
      "InviteSummary": {
        "type": "object",
        "description": "An invite as the admin list shows it.",
        "required": [
          "code",
          "expires_at",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/InviteStatus"
          },
          "used_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "used_by_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Email of the account registered with this invite."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "device_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown in the list of sessions, e.g. \"iPhone Safari\"."
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "The signed-in user.",
        "required": [
          "id",
          "email",
          "display_name",
          "is_admin",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "required": [
          "version",
          "features"
        ],
        "properties": {
          "features": {
            "$ref": "#/components/schemas/Features"
          },
          "version": {
            "type": "string",
            "description": "Server version (Cargo package version)."
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "invite_code",
          "display_name",
          "email",
          "password"
        ],
        "properties": {
          "device_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "invite_code": {
            "type": "string",
            "description": "The 12-character code from the invite link; letter case does not matter."
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ac_session"
      }
    }
  }
}
