{
  "openapi": "3.1.0",
  "info": {
    "title": "Annette Cards API",
    "description": "Annette Cards server: API, sync and the embedded PWA",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check including a database ping.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Server version and enabled optional features.",
        "operationId": "meta",
        "responses": {
          "200": {
            "description": "Server metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "Error response body: `{ \"code\": \"not_found\", \"details\": null }`.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable snake_case error code, never user-facing text."
          },
          "details": {
            "description": "Optional machine-readable details (e.g. which field is invalid)."
          }
        }
      },
      "Features": {
        "type": "object",
        "description": "Optional server features; the client hides the UI of disabled ones.",
        "required": [
          "tts",
          "commons",
          "enrich",
          "push"
        ],
        "properties": {
          "commons": {
            "type": "boolean"
          },
          "enrich": {
            "type": "boolean"
          },
          "push": {
            "type": "boolean"
          },
          "tts": {
            "type": "boolean"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "MetaResponse": {
        "type": "object",
        "required": [
          "version",
          "features"
        ],
        "properties": {
          "features": {
            "$ref": "#/components/schemas/Features"
          },
          "version": {
            "type": "string",
            "description": "Server version (Cargo package version)."
          }
        }
      }
    }
  }
}
